        size_hint: 1, 0.05

    BoxLayout:
        size_hint: 1, 0.10
        orientation: "horizontal"
        Widget:
            size_hint: 0.05, 1
        Label:
            size_hint: 0.95, 1
            font_name: "p_light"
            font_size: root.widget_height_8
            color: chex("#FFFFFF")
            text: "[font=p_bold]Selected Plan :[/font]   Home Plan"
            halign: "left"
            valign : "center"
            text_size: self.size
            markup: True
    
    Widget:
        size_hint: 1, 0.05

    BoxLayout:
        size_hint: 1, 0.7

        Widget:
            size_hint: 0.05, 1

        BoxLayout:
            size_hint: 0.44, 1
            orientation: "vertical"
            
            Label:
                size_hint: 1, 0.1
                font_name: "p_bold"
                font_size: root.widget_height_6
                color: chex("#FFFFFF")
                text: "Available Add-ons Plan"
                halign: "left"
                valign : "center"
                text_size: self.size
                markup: True
            
            Widget:
                size_hint: 1, 0.05

            AdditionalPlanList:
                id: selected_additional_plan_list
                size_hint: 1, 0.85


        Widget:
            size_hint: 0.02, 1

        BoxLayout:
            size_hint: 0.44, 1
            orientation: "vertical"

            Label:
                size_hint: 1, 0.1
                font_name: "p_bold"
                font_size: root.widget_height_6
                color: chex("#FFFFFF")
                text: "Available Add-ons Plan"
                halign: "left"
                valign : "center"
                text_size: self.size
                markup: True
            
            Widget:
                size_hint: 1, 0.05

            AdditionalPlanList:
                id: selected_installment_plan_list
                size_hint: 1, 0.85


        Widget:
            size_hint: 0.05, 1

    Widget:
        size_hint: 1, 0.1


